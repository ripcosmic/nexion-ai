# Public URL of the app. Set this to your HTTPS URL in production.
APP_URL=http://localhost:4173

# Session cookie hardening. In production (NODE_ENV=production) or when this is
# "true", the session cookie is marked Secure and only sent over HTTPS.
NEXION_SECURE_COOKIES=false

# Private SQL database location (SQLite via node:sqlite). Keep this outside any
# directory that is served to the web. Defaults to ./data/nexion.sqlite.
# NEXION_DATA_DIR=./data
# NEXION_DB_FILE=./data/nexion.sqlite

# Optional: passwordless email (magic link) sign-in. Only needed if you want to
# use the "email a sign-in link" flow in addition to password login.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Nexion <noreply@example.com>

# Optional: Ollama proxy target for local model generation.
OLLAMA_URL=http://127.0.0.1:11434

# OpenRouter dataset generation. This creates training examples; it does not
# fine-tune OpenRouter-hosted model weights.
OPENROUTER_API_KEY=replace-with-a-new-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VARIANTS=2
OPENROUTER_MAX_EXAMPLES=500

# Optional Firebase Firestore audit logging.
# Create a Firebase service account and keep these values private.
# Prefer the downloaded JSON file for local development:
FIREBASE_SERVICE_ACCOUNT_FILE=./nexion-ai-646ef-firebase-adminsdk-fbsvc-077bc081f6.json
# Or provide the individual values instead:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"