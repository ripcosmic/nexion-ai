# Public URL of the app. Set this to your HTTPS URL in production.
APP_URL=http://localhost:4173

# Session cookie hardening. In production (NODE_ENV=production) or when this is
# "true", the session cookie is marked Secure and only sent over HTTPS.
NEXION_SECURE_COOKIES=false

# Private SQL database location (SQLite via node:sqlite). Keep this outside any
# directory that is served to the web. Defaults to ./data/nexion.sqlite.
# NEXION_DATA_DIR=./data
# NEXION_DB_FILE=./data/nexion.sqlite

# Optional: passwordless email (magic link) sign-in. Only needed if you want to
# use the "email a sign-in link" flow in addition to password login.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Nexion <noreply@example.com>

# Optional: Ollama proxy target for local model generation.
OLLAMA_URL=http://127.0.0.1:11434